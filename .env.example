# Set the verified production domain, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.eaccjardines.com
# GA4 web stream. GTM takes precedence, avoiding a duplicate direct installation.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-FZF7K4NYXJ

# Alternative to a direct GA4 ID: use exactly one published Tag Manager container.
NEXT_PUBLIC_GTM_ID=GTM-KWWXX8G5

# Sanity CMS (project ID and dataset are public; tokens must remain server-only)
NEXT_PUBLIC_SANITY_PROJECT_ID=vg9zlhhc
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
# Temporary migration only; never deploy an Editor token.
SANITY_API_WRITE_TOKEN=
